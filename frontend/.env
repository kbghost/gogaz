# Backend API URL (en production, mettre votre domaine)
VITE_API_URL= https://gogaz.onrender.com
VITE_SOCKET_URL= https://gogaz.onrender.com

# Google Maps API Key (optionnel — sans clé, la carte GPS fonctionne quand même via navigator.geolocation)
# Obtenez une clé sur https://console.cloud.google.com → activer "Maps JavaScript API"
VITE_GOOGLE_MAPS_KEY=
